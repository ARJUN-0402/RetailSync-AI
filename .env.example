# RetailSync AI Environment Variables
# Copy this file to .env and update values
# WARNING: Never commit .env to version control.

# Database
DATABASE_URL=sqlite:///database/retailsync.db
DATABASE_PATH=database/retailsync.db

# Application
APP_NAME=RetailSync AI
APP_VERSION=2.0.0
APP_ENV=development
APP_DEBUG=false

# Paths
RAW_DATA_PATH=data/raw
PROCESSED_DATA_PATH=data/processed
MODELS_PATH=models
DOCS_PATH=docs
DATABASE_DIR=database
LOG_DIR=logs

# Dashboard
STREAMLIT_PORT=8501
STREAMLIT_HOST=localhost
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/retailsync.log

# AI Analyst
RETAILSYNC_AI_API_KEY=
RETAILSYNC_AI_PROVIDER=openai
RETAILSYNC_AI_MODEL=gpt-4o-mini
RETAILSYNC_AI_BASE_URL=
RETAILSYNC_AI_OFFLINE_MODE=false
RETAILSYNC_AI_DISABLE_TOOLS=false
RETAILSYNC_AI_DISABLE_RAG=false
